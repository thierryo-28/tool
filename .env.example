NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Enable remote named views (API + Supabase). When false, localStorage is used.
NEXT_PUBLIC_ENABLE_REMOTE_VIEWS=false

# Optional legacy override when a workspace was pre-created in Supabase.
# Leave unset (or placeholder) for automatic first-user workspace bootstrap.
# NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=
