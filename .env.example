NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Enable remote named views (API + Supabase). When false, localStorage is used.
NEXT_PUBLIC_ENABLE_REMOTE_VIEWS=false

# Workspace id used by toolbar API calls.
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
